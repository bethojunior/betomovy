{
  "minimum-stability": "dev",
  "require": {
    "ext-json": "*",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-mongodb": "*",
    "ext-sodium": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-zlib": "*",
    "pusher/pusher-php-server": "^3.1",
    "aws/aws-sdk-php": "^3.65",
    "cboden/ratchet": "^0.4",
    "phpmailer/phpmailer": "^6.0",
    "mercadopago/dx-php": "1.2.3",
    "phpunit/phpunit": "^8.0",
    "nesbot/carbon": "^2.16",
    "kreait/firebase-php": "^6.0",
    "google/cloud-firestore": "^1.4",
    "emcconville/google-map-polyline-encoding-tool": "^1.3",
    "developersrede/erede-php": "^4.2",
    "predis/predis": "^1.1",
    "vlucas/phpdotenv": "5.4.x-dev",
    "roseo/cielo-api-3.0-php": "dev-main",
    "cache/mongodb-adapter": "^1.3",
    "alymosul/exponent-server-sdk-php": "^1.3"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "post-install-cmd": [
      "composer dumpautoload --no-interaction"
    ]
  },
  "require-dev": {
    "symfony/browser-kit": "^4.2",
    "symfony/css-selector": "^4.2",
    "symfony/phpunit-bridge": "^4.2"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app",
      "WideImage\\": "utils/lib",
      "tests\\": "tests"
    },
    "files": [
      "utils/lib/WideImage.php",
      "app/helpers/DateFormat.php",
      "app/helpers/Debug.php",
      "app/helpers/Encryption.php",
      "app/helpers/FormatString.php",
      "app/helpers/Job.php",
      "app/helpers/Mongo.php",
      "app/helpers/Time.php",
      "app/helpers/writeLine.php"
    ]
  }
}
