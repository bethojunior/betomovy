<?xml version='1.0' encoding='utf-8'?>
<widget id="br.com.driver.rota101" version="1.60.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Route 95 Motorista</name>
    <icon density="mdpi" height="57" src="res/icon/android/logo.png" width="57" />
    <icon background="@color/background" density="mdpi" foreground="res/icon/android/logo.png" />
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="http://cordova.io">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="maps:*" />
    <access launch-external="yes" origin="geo:*" />
    <allow-intent href="tel:*" />
    <allow-intent href="geo:*" />
    <access origin="maps:*" />
    <allow-intent href="maps:*" />
    <preference name="Orientation" value="portrait" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <preference name="loadUrlTimeoutValue" value="700000" />
    <preference name="KeepRunning" value="true" />
    <platform name="android">
        <allow-intent href="market:*" />
        <access origin="*" />
        <allow-intent href="*" />
        <allow-navigation href="*" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <resource-file src="res/icon/android/logo.png" target="app/src/main/res/mipmap/icon.png" />
        <resource-file src="res/icon/android/mipmap-mdpi/ic_launcher.png" target="app/src/main/res/drawable-mdpi/ic_launcher.png" />
        <resource-file src="res/icon/android/mipmap-hdpi/ic_launcher.png" target="app/src/main/res/drawable-hdpi/ic_launcher.png" />
        <resource-file src="res/icon/android/mipmap-xhdpi/ic_launcher.png" target="app/src/main/res/drawable-xhdpi/ic_launcher.png" />
        <resource-file src="res/icon/android/mipmap-xxhdpi/ic_launcher.png" target="app/src/main/res/drawable-xxhdpi/ic_launcher.png" />
        <resource-file src="res/icon/android/mipmap-xxxhdpi/ic_launcher.png" target="app/src/main/res/drawable-xxxhdpi/ic_launcher.png" />
        <resource-file src="res/icon/android/colors.xml" target="app/src/main/res/values/colors.xml" />
        <resource-file src="google-services.json" target="app/google-services.json" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity[@android:name='MainActivity']">
            <activity android:windowSoftInputMode="adjustResize" />
        </edit-config>
        <config-file parent="/manifest" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
        </config-file>
        <hook type="after_prepare" src="hooks/after_prepare/fix-kotlin-version.js" />
        <hook type="after_prepare" src="hooks/after_prepare/fix-gps-feature.js" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon/android/logo.png" />
    <plugin name="cordova-plugin-android-gpsdetect" spec="0.0.3" />
    <plugin name="in.lucasdup.bringtofront" spec="https://github.com/markeeftb/cordova-bring-to-front" />
    <plugin name="cordova-plugin-vibration" spec="^3.1.0" />
    <plugin name="cordova-plugin-dialogs" spec="^2.0.1" />
    <plugin name="cordova-plugin-ping" spec="^0.4.0" />
    <plugin name="cordova-plugin-appminimize" spec="^1.0.0" />
    <plugin name="cordova-plugin-app-version" spec="^0.1.9" />
    <plugin name="cordova-plugin-gallery-refresh" spec="^1.0.61" />
    <plugin name="cordova-plugin-battery-status" spec="^2.0.2" />
    <plugin name="cordova-plugin-call-number" spec="^1.0.1" />
    <plugin name="cordova-plugin-qrcodejs" spec="^1.0.0" />
    <plugin name="cordova-plugin-request-location-accuracy" spec="^2.2.3" />
    <plugin name="cordova-plugin-local-notification-12" spec="^0.1.4" />
    <plugin name="cordova-plugin-ionic-keyboard" spec="^2.1.3" />
    <preference name="GOOGLE_MAPS_ANDROID_API_KEY" value="AIzaSyAi8KBHM6dO6tpF7apf8B5qnftv_wfpytg" />
    <preference name="GOOGLE_MAPS_PLAY_SERVICES_VERSION" value="18.2.0" />
    <preference name="GOOGLE_MAPS_PLAY_SERVICES_LOCATION_VERSION" value="21.0.1" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-compileSdkVersion" value="35" />
    <preference name="android-targetSdkVersion" value="35" />
    

    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#1d4873" />
    <preference name="StatusBarStyle" value="lightcontent" />
    
    <plugin name="cordova-plugin-insomnia" spec="https://github.com/EddyVerbruggen/Insomnia-PhoneGap-Plugin.git" />
    <plugin name="phonegap-plugin-mobile-accessibility" spec="https://github.com/phonegap/phonegap-mobile-accessibility.git" />
    <plugin name="cordova-plugin-foreground-service" spec="^1.1.2" />
</widget>
