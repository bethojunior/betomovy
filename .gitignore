# 1. Arquivos de Ambiente e Credenciais (CRÍTICO)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.prod
!*.env.example
!*.env.example.*
!mobilidade-site-novo-main/.env.build
!mobilidade-monitor-new-main/.env.build
!*.env.build.example
configs/env/env.json
configs/env/push.json
GoogleService-Info.plist
google-services.json

# 2. Chaves de Assinatura, Certificados e Secrets
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.pem
*.key
*.crt
*.cert
backup/keystore.jks*
BANCO DE DADOS MIGRAR PARA OCEAN/
*.sql

# 3. Dependências
node_modules/
vendor/
.yalc/
yalc.lock
.pnp
.pnp.js

# 4. Logs e Arquivos Temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
storage/logs/*
!storage/logs/.gitignore
storage/debugbar/*
!storage/debugbar/.gitignore
.tmp/
tmp/
temp/
*.tmp

# 5. Frameworks Cache & Build (Laravel, Vite, React, Expo)
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
bootstrap/cache/*
!bootstrap/cache/.gitignore
.phpunit.result.cache
dist/
build/
out/
.expo/
.next/
web-build/

# 6. Cordova / Mobile Builds
platforms/
plugins/

# 7. Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

