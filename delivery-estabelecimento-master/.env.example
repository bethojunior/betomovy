APP_NAME=DeliveryEstabelecimento
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Origens exatas liberadas no CORS, separadas por virgula.
# Use "*" apenas enquanto CORS_SUPPORTS_CREDENTIALS estiver desligado.
CORS_ALLOWED_ORIGINS=http://localhost
# Dominios cujos subdominios tambem sao liberados (qualquer porta).
CORS_ALLOWED_ORIGIN_SUFFIXES=example.com,example.com.br
# Tempo (em segundos) que o navegador guarda a resposta do preflight.
CORS_MAX_AGE=3600
# Ative apenas se a API passar a autenticar por cookie/sessao.
CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_db
DB_USERNAME=root
DB_PASSWORD=

DB_MONGO_HOST=127.0.0.1
DB_MONGO_PORT=27017
DB_MONGO_DATABASE=delivery_mongo
DB_MONGO_USERNAME=
DB_MONGO_PASSWORD=

RETHINK_DB_HOST=127.0.0.1
RETHINK_DB_NAME=delivery_rethink
RETHINK_DB_USER=admin
RETHINK_DB_PASS=
RETHINK_DB_PORT=28015

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=nao-responda@exemplo.com.br
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
