# 1. BUILD STAGE
FROM node:20.5-alpine3.17 AS build

LABEL maintainer="704apps" \
      description="Mobilidade Monitor New" \
      version="1.0"

# Disable source map generation for production
ENV GENERATE_SOURCEMAP=false

WORKDIR /app

# Copy package files first for better caching
COPY ./package*.json ./
RUN NODE_OPTIONS=--max-old-space-size=4096 npm install --legacy-peer-deps

# Copy source code
COPY ./ . 

# Build the React app
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run prd-build

# 2. PRODUCTION STAGE
FROM nginx:1.24.0-alpine

# Remove default nginx config and copy custom configuration
RUN rm -rf /etc/nginx/conf.d
COPY ./docker-prod/config/nginx /etc/nginx

# Copy built files from build stage
COPY --from=build /app/dist/ /usr/share/nginx/html/

# Set working directory
WORKDIR /usr/share/nginx/html

# .env is not copied here (not in repo); mount it at runtime via volume
COPY ./env.sh ./
RUN chmod +x env.sh

# Copy start script
COPY ./docker-prod/config/start.sh /start.sh
RUN chmod +x /start.sh


# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 86

# Start with our custom script
CMD ["/start.sh"]